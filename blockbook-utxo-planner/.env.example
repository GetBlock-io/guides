# Your GetBlock Bitcoin endpoint with the Blockbook add-on enabled (REST).
# Everything here is a GET request -- no signing, no keys, no broadcast.
BLOCKBOOK_URL=https://shared.eu-central-1.getblock.io/<YOUR_ACCESS_TOKEN>

# The address to spend from. This default is a busy public address with a
# fragmented, dust-heavy UTXO set, which is exactly what makes coin selection
# interesting. In production this is an address your wallet controls.
SPEND_FROM=bc1q3zcdunpmqgn8enyxa3smu7fwrfvya35dz3uvjy

# Where the payment would go. Only its script type matters here -- the planner
# never builds or broadcasts a transaction, it only sizes the output.
SEND_TO=bc1qwzrryqr3ja8w7hnja2spmkgfdcgvqwp5swz4af4ngsjecfz0w0pqud7k38

# Confirmations an output needs before this planner will spend it. 1 keeps
# unconfirmed change out of the selection; 0 spends from the mempool, which
# means inheriting the parent transaction's replaceability.
MIN_CONFIRMATIONS=1
