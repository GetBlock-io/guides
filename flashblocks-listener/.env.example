# GetBlock flashblocks-enabled access tokens (the path segment of your
# wss://go.getblock.io/<TOKEN> endpoint). Copy this file to .env and fill in.
# .env is git-ignored — never commit real tokens.

# Base (chainId 8453) — must be flashblocks-enabled
BASE_MAINNET_TOKEN=your_base_mainnet_token_here
BASE_SEPOLIA_TOKEN=your_base_sepolia_token_here

# Optimism (chainId 10) — must be flashblocks-enabled
OPTIMISM_MAINNET_TOKEN=your_optimism_mainnet_token_here
OPTIMISM_SEPOLIA_TOKEN=your_optimism_sepolia_token_here
