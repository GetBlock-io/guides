# GetBlock endpoints for Robinhood Chain — copy from https://account.getblock.io
# JSON-RPC (HTTP) endpoint, e.g. https://go.getblock.io/<ACCESS_TOKEN>/
GETBLOCK_RPC_URL=

# WebSocket endpoint (optional, needed for watch-blocks.js), e.g. wss://go.getblock.io/<ACCESS_TOKEN>/
GETBLOCK_WS_URL=

# OpenAI API key (needed for agent.js) — https://platform.openai.com
OPENAI_API_KEY=

# Optional: override the model used by the agent (default: gpt-5.1)
# OPENAI_MODEL=gpt-5.1
