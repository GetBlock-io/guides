# 1. GETBLOCK RPC URL (Required)
RPC_URL=https://api.devnet.solana.com

# For MAINNET (production):
# MAINNET_RPC_URL="https://go.getblock.io/<ACCESS_TOKEN>"

# 2. WALLET PRIVATE KEY (Required)
# ⚠️  NEVER use your main wallet, Create a dedicated "burner" wallet for testing.
# Export from Phantom: Settings > Security > Export Private Key

SOLANA_PRIVATE_KEY=your_private_key

# 3. OPENAI API KEY (Required)
# Powers the AI reasoning layer
# Get yours at: https://platform.openai.com/api-keys
#
OPENAI_API_KEY=your_API_KEY