# Wallet that signs the swap.
# Use a throwaway key funded with a dollar or two. Never a wallet holding real funds.
PRIVATE_KEY=0x...

# GetBlock BSC endpoint with the MEV Protection add-on enabled.
# Create a BSC endpoint in the dashboard, then turn on MEV Protection for it.
# This one URL is the entire integration - the swap code below never changes.
BSC_MEV_RPC=https://go.getblock.io/<YOUR_ACCESS_TOKEN>
